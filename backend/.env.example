APP_NAME=Patient Side API
MONGO_URI=mongodb://localhost:27017
# Alias supported by backend as well
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=patient_platform
APP_API_KEY=change-this-32-char-secret
SECRET_PEPPER=change-me-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# Razorpay Payment Gateway Configuration
# Get these from https://dashboard.razorpay.com/app/keys
# Test Mode (for development):
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_test_secret_key_here

# Production Mode (uncomment and update when ready):
# RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXX
# RAZORPAY_KEY_SECRET=your_production_secret_key_here

# Payment webhook configuration (optional)
WEBHOOK_URL=https://your-domain.com/payments/webhook
WEBHOOK_SECRET=your_webhook_secret_key_here
